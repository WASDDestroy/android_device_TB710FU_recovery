#!/system/bin/sh
# Shows the numeric key code that curses receives. Press arrows / Enter / Esc,
# read the number, press q to quit.
WS=/data/avbpowertool2_workspace
export PYTHONHOME=/python_env
export LD_LIBRARY_PATH=/python_env:/system/lib64:$LD_LIBRARY_PATH
export PYTHONPATH="$WS/python312.zip:$WS/pylib"
export TERMINFO="$WS/terminfo"
[ -n "$AVBPT_TERM" ] && export TERM="$AVBPT_TERM"
first=$(printf '%s' "${TERM:-x}" | cut -c1)
[ -f "$TERMINFO/$first/${TERM:-x}" ] || export TERM=twrp
if [ -n "$AVBPT_LINES" ] && [ -n "$AVBPT_COLS" ]; then
    export LINES="$AVBPT_LINES" COLUMNS="$AVBPT_COLS"
elif [ -s "$WS/terminal.conf" ]; then
    read -r gl gc < "$WS/terminal.conf"; export LINES="$gl" COLUMNS="$gc"
fi

/python_env/python - <<'PY'
import curses
NAMES = {curses.KEY_UP: "KEY_UP", curses.KEY_DOWN: "KEY_DOWN",
         curses.KEY_LEFT: "KEY_LEFT", curses.KEY_RIGHT: "KEY_RIGHT",
         27: "ESC", 10: "ENTER", 13: "ENTER", curses.KEY_ENTER: "KEY_ENTER",
         127: "BACKSPACE", 8: "BACKSPACE"}

def main(s):
    try:
        curses.curs_set(0)
    except Exception:
        pass
    s.keypad(True)
    last = "<none>"
    while True:
        s.erase()
        s.addstr(0, 0, "keytest  (TERM=%s)  press keys, q = quit" % __import__("os").environ.get("TERM"))
        s.addstr(2, 0, "last key: %s" % last)
        s.addstr(4, 0, "up=259 down=258 right=261 left=260 enter=10/13 esc=27")
        s.refresh()
        k = s.getch()
        if k == ord("q"):
            break
        last = "%d (%s)" % (k, NAMES.get(k, ""))

curses.wrapper(main)
print("bye")
PY
