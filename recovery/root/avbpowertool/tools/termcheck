#!/system/bin/sh
# Terminal diagnostics for AVBPowerTool2 TUI in TWRP.
# Prints geometry/capability info, then draws an ASCII ruler grid.
WS=/data/avbpowertool2_workspace
export PYTHONHOME=/python_env
export LD_LIBRARY_PATH=/python_env:/system/lib64:$LD_LIBRARY_PATH
export PYTHONPATH="$WS/python312.zip:$WS/pylib"
export TERMINFO="$WS/terminfo"
export PATH="$WS/bin:$PYTHONHOME:$PATH"
if [ -s "$WS/terminal.conf" ]; then read -r gl gc < "$WS/terminal.conf"; [ -n "$gl" ] && export LINES="$gl" COLUMNS="$gc"; fi

# same TERM normalisation as avbpt, so this script never dies on bg1.25
[ -n "$AVBPT_TERM" ] && export TERM="$AVBPT_TERM"
if [ -n "$TERM" ]; then
    first=$(printf '%s' "$TERM" | cut -c1)
    if [ ! -f "$TERMINFO/$first/$TERM" ]; then
        echo "termcheck: TERM='$TERM' has no usable entry, using 'twrp'"
        export TERM=twrp
    fi
else
    export TERM=twrp
fi

echo "TERM=$TERM"
stty size 2>/dev/null && echo "(stty size above)"
echo "LANG=${LANG:-<unset>} LC_ALL=${LC_ALL:-<unset>}"

/python_env/python - <<'PY'
import os
try:
    print("os.get_terminal_size:", os.get_terminal_size(1))
except Exception as e:
    print("os.get_terminal_size failed:", e)
try:
    import curses
    curses.setupterm()
    print("tigetnum lines/cols:", curses.tigetnum("lines"), curses.tigetnum("cols"))
    for cap in ("cup", "clear", "smcup", "el", "civis", "cnorm", "setaf"):
        print(f"  {cap}: {curses.tigetstr(cap)!r}")
except Exception as e:
    print("setupterm failed:", repr(e))
PY

echo
echo "Drawing ASCII grid for 8s ... (row 00 at top-left? lines wrapping?)"
/python_env/python - <<'PY'
import curses, time
def main(s):
    try:
        curses.curs_set(0)
    except Exception:
        pass
    s.erase()
    h, w = s.getmaxyx()
    ruler = "0123456789" * 20
    for r in range(h - 1):
        s.addstr(r, 0, ("%02d|" % r) + ruler[: max(0, w - 4)])
    s.addstr(h - 1, 0, ("-- %dx%d --" % (h, w)).ljust(w - 1), curses.A_REVERSE)
    s.refresh()
    time.sleep(8)
curses.wrapper(main)
print("done")
PY
